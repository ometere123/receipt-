# Set after independently verifying the FINALIZED single-contract Studionet
# deployment. Do not put private keys in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_RECEIPT_V2_ADDRESS=
NEXT_PUBLIC_EXPLORER_URL=https://explorer-studio.genlayer.com
# Must match the funded ReceiptV2 get_config() response.
NEXT_PUBLIC_FUNDING_ENABLED=true

# Optional V1 history-only addresses. They are never used for V2 writes.
NEXT_PUBLIC_HISTORICAL_PROOF_ENGINE_ADDRESS=
NEXT_PUBLIC_HISTORICAL_PROMISE_VAULT_ADDRESS=
